  #!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.35.2
K3S_IMAGE=rancher/k3s:v1.35.2-k3s1
CLUSTER=${HOTEL_CLUSTER:-hotelflow}
[[ "$CLUSTER" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { echo 'Invalid HOTEL_CLUSTER' >&2; exit 1; }
STATE="$ROOT/.local/$CLUSTER"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)
case "$ARCH" in arm64|aarch64) ARCH=arm64 ;; x86_64|amd64) ARCH=amd64 ;; *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; esac
case "$OS" in darwin|linux) ;; *) echo 'Use macOS, Linux or Ubuntu in WSL2.' >&2; exit 1 ;; esac
BIN="$ROOT/.local/bin/$OS-$ARCH"
K3D="$BIN/k3d-$K3D_VERSION"
KUBECTL="$BIN/kubectl-$KUBECTL_VERSION"
KUBECONFIG_FILE="$STATE/kubeconfig"
umask 077
mkdir -p "$BIN" "$STATE"

fail() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[hotelctl] $*"; }
checksum() {
  if command -v sha256sum >/dev/null; then sha256sum "$1" | awk '{print $1}';
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
download() { curl --fail --silent --show-error --location --retry 3 --connect-timeout 15 --max-time 300 "$1" -o "$2"; }
prerequisites() {
  command -v docker >/dev/null || fail 'Install and start Docker first (Docker Desktop / Docker Engine).'
  command -v curl >/dev/null || fail 'Install curl.'
  command -v sha256sum >/dev/null || command -v shasum >/dev/null || fail 'Install sha256sum or shasum.'
  docker info >/dev/null 2>&1 || fail 'Docker is unavailable. Start Docker; on Windows enable WSL integration.'
  [[ $(docker info --format '{{.OSType}}') == linux ]] || fail 'Docker must use Linux containers.'
}
tools() {
  if [[ ! -x "$K3D" ]]; then
    log "Downloading k3d $K3D_VERSION ($OS/$ARCH)"
    local asset="k3d-$OS-$ARCH" expected
    download "https://github.com/k3d-io/k3d/releases/download/$K3D_VERSION/$asset" "$K3D.tmp"
    download "https://github.com/k3d-io/k3d/releases/download/$K3D_VERSION/checksums.txt" "$K3D.sums"
    expected=$(awk -v name="$asset" '{file=$2; sub(/^.*\//, "", file); sub(/^\*/, "", file); if (file == name) print $1}' "$K3D.sums")
    [[ -n "$expected" && $(checksum "$K3D.tmp") == "$expected" ]] || fail 'k3d checksum mismatch.'
    chmod +x "$K3D.tmp"
    mv "$K3D.tmp" "$K3D"
  fi
  if [[ ! -x "$KUBECTL" ]]; then
    log "Downloading kubectl $KUBECTL_VERSION ($OS/$ARCH)"
    local url="https://dl.k8s.io/release/$KUBECTL_VERSION/bin/$OS/$ARCH/kubectl" expected
    download "$url" "$KUBECTL.tmp"
    download "$url.sha256" "$KUBECTL.sha256"
    expected=$(tr -d '[:space:]' < "$KUBECTL.sha256")
    [[ $(checksum "$KUBECTL.tmp") == "$expected" ]] || fail 'kubectl checksum mismatch.'
    chmod +x "$KUBECTL.tmp"
    mv "$KUBECTL.tmp" "$KUBECTL"
  fi
}
kube() { "$KUBECTL" --kubeconfig "$KUBECONFIG_FILE" "$@"; }
settings() {
  local saved_http=8080 saved_api=6550 saved_bind=127.0.0.1 saved_agents=0 saved_image="$K3S_IMAGE" saved_grpc=9090 saved_admin=8081
  if [[ -f "$STATE/settings" ]]; then
    IFS='|' read -r saved_http saved_api saved_bind saved_agents saved_image saved_grpc saved_admin < "$STATE/settings"
  fi
  HTTP_PORT=${HOTEL_HTTP_PORT:-$saved_http}
  API_PORT=${HOTEL_API_PORT:-$saved_api}
  BIND_ADDRESS=${HOTEL_BIND_ADDRESS:-$saved_bind}
  AGENTS=${HOTEL_AGENTS:-$saved_agents}
  GRPC_PORT=${HOTEL_GRPC_PORT:-${saved_grpc:-9090}}
  ADMIN_PORT=${HOTEL_ADMIN_PORT:-${saved_admin:-8081}}
  for port in "$HTTP_PORT" "$API_PORT" "$GRPC_PORT" "$ADMIN_PORT"; do
    [[ "$port" =~ ^[0-9]{1,5}$ && "$port" -ge 1024 && "$port" -le 65535 ]] || fail 'Ports must be in range 1024..65535.'
  done
  [[ $(printf '%s\n' "$HTTP_PORT" "$API_PORT" "$GRPC_PORT" "$ADMIN_PORT" | sort -u | wc -l | tr -d ' ') == 4 ]] || fail 'HTTP, gRPC, admin and Kubernetes API ports must differ.'
  [[ "$AGENTS" =~ ^[0-9]$ ]] || fail 'Agent count must be between 0 and 9.'
  [[ "$BIND_ADDRESS" == 127.0.0.1 || "$BIND_ADDRESS" == 0.0.0.0 ]] || fail 'HOTEL_BIND_ADDRESS must be 127.0.0.1 or 0.0.0.0.'
  SETTINGS="$HTTP_PORT|$API_PORT|$BIND_ADDRESS|$AGENTS|$K3S_IMAGE|$GRPC_PORT|$ADMIN_PORT"
  if [[ -f "$STATE/settings" && "$SETTINGS" != "$(cat "$STATE/settings")" ]]; then
    fail 'Existing cluster has different ports, node count or k3s version. Use another HOTEL_CLUSTER or explicitly destroy this cluster first.'
  fi
}
existing() { docker inspect "k3d-$CLUSTER-server-0" >/dev/null 2>&1; }
diagnostics() {
  if [[ -x "$KUBECTL" && -f "$KUBECONFIG_FILE" ]]; then
    kube get pods -A -o wide --request-timeout=5s || true
    kube -n hotelflow get events --sort-by=.lastTimestamp --request-timeout=5s | tail -20 || true
    kube -n hotelflow logs deployment/api-gateway --tail=40 --request-timeout=5s || true
  fi
}
smoke() {
  local base="http://127.0.0.1:$HTTP_PORT" result
  log "Checking external HTTP: $base/v1/echo"
  result=$(curl --noproxy '*' --fail --silent --show-error --retry 20 --retry-connrefused --retry-delay 1 --max-time 3 \
    -H 'Content-Type: application/json' -d '{"message":"HotelFlow"}' "$base/v1/echo")
  [[ "$result" == '{"message":"HotelFlow"}' ]] || fail "Unexpected Echo response: $result"
  result=$(curl --noproxy '*' -fsS --max-time 5 "$base/v1/echo?message=HotelFlow")
  [[ "$result" == '{"message":"HotelFlow"}' ]] || fail "Unexpected GET Echo response: $result"
  curl --noproxy '*' -fsS --max-time 5 "$base/swagger.json" | grep -q 'HotelFlow API Gateway'
  for probe in live ready startup; do
    curl --noproxy '*' -fsS --retry 15 --retry-connrefused --retry-delay 1 --max-time 3 "http://127.0.0.1:$ADMIN_PORT/healthcheck/$probe" >/dev/null
  done
  log 'Echo POST/GET, OpenAPI and all healthchecks from host: OK'
  echo "API:     http://localhost:$HTTP_PORT/v1/echo"
  echo "Swagger: http://localhost:$HTTP_PORT/docs/"
  echo "gRPC:    localhost:$GRPC_PORT"
  echo "Health:  http://localhost:$ADMIN_PORT/healthcheck/live"
  if [[ "$BIND_ADDRESS" == 0.0.0.0 ]]; then echo "LAN:     http://<computer-ip>:$HTTP_PORT/v1/echo"; fi
}
up() {
  prerequisites
  tools
  settings
  trap 'echo "Startup failed. Diagnostic state:" >&2; diagnostics' ERR
  if existing; then
    [[ -f "$STATE/settings" ]] || fail 'Cluster exists without local ownership metadata. Choose another HOTEL_CLUSTER.'
    log "Starting existing cluster $CLUSTER"
    "$K3D" cluster start "$CLUSTER" --wait
  else
    log "Creating k3s cluster: 1 server + $AGENTS agents"
    # Render from the tracked config; never update the user's default kubeconfig.
    sed -e "s/name: hotelflow/name: $CLUSTER/" \
      -e "s/agents: 0/agents: $AGENTS/" \
      -e "s/hostPort: \"6550\"/hostPort: \"$API_PORT\"/" \
      -e "s/127.0.0.1:8080:80/$BIND_ADDRESS:$HTTP_PORT:80/" \
      -e "s/127.0.0.1:9090:30090/$BIND_ADDRESS:$GRPC_PORT:30090/" \
      -e "s/127.0.0.1:8081:30081/$BIND_ADDRESS:$ADMIN_PORT:30081/" \
      "$ROOT/deployment/k3d.yaml" > "$STATE/k3d.yaml"
    "$K3D" cluster create --config "$STATE/k3d.yaml"
    printf '%s\n' "$SETTINGS" > "$STATE/settings"
  fi
  "$K3D" kubeconfig get "$CLUSTER" > "$KUBECONFIG_FILE.tmp"
  mv "$KUBECONFIG_FILE.tmp" "$KUBECONFIG_FILE"
  kube wait --for=condition=Ready nodes --all --timeout=180s
  log 'Building api-gateway from this monorepository'
  docker build -f "$ROOT/services/api-gateway/build/Dockerfile" \
    -t hotelflow/api-gateway:local "$ROOT/services/api-gateway"
  local digest image
  digest=$(docker image inspect hotelflow/api-gateway:local --format '{{.Id}}')
  digest=${digest#sha256:}
  image="hotelflow/api-gateway:sha-${digest:0:16}"
  docker tag hotelflow/api-gateway:local "$image"
  "$K3D" image import "$image" -c "$CLUSTER"
  kube kustomize "$ROOT/services/api-gateway/build/deployment" |
    sed "s|image: hotelflow/api-gateway:local|image: $image|" > "$STATE/api-gateway.yaml"
  kube apply -f "$STATE/api-gateway.yaml"
  kube -n hotelflow rollout status deployment/api-gateway --timeout=180s
  # Traefik is installed asynchronously by k3s. Poll its deployment creation too.
  local ready=0
  for ((i=0;i<90;i++)); do
    if kube -n kube-system get deployment traefik --request-timeout=5s >/dev/null 2>&1; then ready=1; break; fi
    sleep 2
  done
  [[ "$ready" == 1 ]] || fail 'Traefik was not installed by k3s.'
  kube -n kube-system rollout status deployment/traefik --timeout=180s
  smoke
  trap - ERR
}
usage() {
  cat <<'EOF'
HotelFlow: k3s + api-gateway

  ./hotelctl up [--agents N]   Create/start cluster, build, deploy and verify Echo
  ./hotelctl smoke             Check Echo from outside the cluster
  ./hotelctl status            Show nodes, gateway and ingress
  ./hotelctl logs              Gateway logs
  ./hotelctl stop              Stop cluster and preserve its containers/state
  ./hotelctl destroy           Delete this course cluster (destructive)
  ./hotelctl kubectl ARGS...   kubectl with isolated course kubeconfig

Optional: HOTEL_CLUSTER, HOTEL_HTTP_PORT, HOTEL_GRPC_PORT, HOTEL_ADMIN_PORT,
          HOTEL_API_PORT, HOTEL_BIND_ADDRESS.
Windows: run in WSL2 with Docker Desktop integration enabled.
EOF
}
command=${1:-help}
[[ $# -eq 0 ]] || shift
case "$command" in
  up)
    if [[ $# -gt 0 ]]; then
      [[ $# -eq 2 && "$1" == --agents ]] || fail 'Usage: ./hotelctl up [--agents N]'
      HOTEL_AGENTS=$2
    fi
    up ;;
  smoke) prerequisites; settings; smoke ;;
  status) prerequisites; tools; kube get nodes; kube -n hotelflow get deployment,pods,service,ingress ;;
  logs) prerequisites; tools; kube -n hotelflow logs deployment/api-gateway --tail=100 ;;
  kubectl) prerequisites; tools; kube "$@" ;;
  stop) prerequisites; tools; [[ -f "$STATE/settings" ]] || fail 'No managed cluster.'; "$K3D" cluster stop "$CLUSTER" ;;
  destroy)
    prerequisites; tools
    [[ -f "$STATE/settings" ]] || fail 'No managed cluster.'
    "$K3D" cluster delete "$CLUSTER"
    rm -f "$STATE/settings" "$KUBECONFIG_FILE"
    log "Deleted cluster $CLUSTER" ;;
  help|--help|-h) usage ;;
  *) usage; exit 1 ;;
esac
