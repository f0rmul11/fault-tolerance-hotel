        },
        "parameters": [
          {
            "name": "hotelId",
            "description": "UUID отеля в Hotels.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "HotelsService"
        ]
      }
    },
    "/v1/rooms/{roomId}": {
      "get": {
        "summary": "Возвращает номер и его условия бронирования без обращения в Review.",
        "operationId": "HotelsService_GetRoom",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/api_gateway.hotels.v1.GetRoomResponse"
