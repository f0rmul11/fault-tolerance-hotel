  "paths": {
    "/v1/hotels": {
      "get": {
        "summary": "Возвращает страницу отелей с рейтингами, полученными одним batch-запросом в Review.",
        "operationId": "HotelsService_ListHotels",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/api_gateway.hotels.v1.ListHotelsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "Размер страницы: по умолчанию 20, допустимо от 1 до 100.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "description": "Число пропускаемых отелей; неотрицательное значение.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "HotelsService"
        ]
      }
    },
    "/v1/hotels/{hotelId}": {
      "get": {
        "summary": "Возвращает сведения об отеле и его пользовательский рейтинг.",
        "operationId": "HotelsService_GetHotel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/api_gateway.hotels.v1.GetHotelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "hotelId",
            "description": "UUID отеля в Hotels.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "HotelsService"
        ]
      }
    },
    "/v1/hotels/{hotelId}/rooms": {
      "get": {
        "summary": "Возвращает номера выбранного отеля без обращения в Review.",
        "operationId": "HotelsService_ListRooms",
        "responses": {
          "200": {
            "description": "A successful response.",
