              "format": "uuid"
            }
          },
          {
            "name": "X-Demo-Role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "RECEPTION",
                "OPERATOR"
              ]
            },
            "description": "Учебная роль; владелец повторно проверяет права."
          },
          {
            "name": "X-Demo-Actor",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID оператора"
          },
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текущий результат",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "$ref": "#/components/schemas/CheckinOperation"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на операцию или чужую бронь.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "409": {
            "description": "FailedPrecondition или Aborted: конфликт либо запрещённое состояние.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "422": {
            "description": "Некорректное тело запроса, UUID, период или длительность для выбранного номера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "503": {
            "description": "Сервис временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotency_key"
                ],
                "properties": {
                  "idempotency_key": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "description": "Повтор того же ключа возвращает текущую операцию. PENDING означает ожидание ответа Booking; REJECTED содержит русское пояснение."
      }
    },
