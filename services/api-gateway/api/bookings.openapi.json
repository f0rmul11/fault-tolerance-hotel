  "components": {
    "headers": {
      "X-Request-Id": {
        "description": "UUID запроса, установленный interceptor после разбора тела. Создаётся при отсутствии входного заголовка.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CreateBookingInput": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Системный ID номера, положительное число в строке.",
            "example": "1"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "Ключ операции, уникальный в пределах гостя. Повтор с тем же составом возвращает ту же бронь; другой состав — 409."
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Начало периода, RFC3339 с часовым поясом; точность до микросекунд."
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "description": "Исключительная правая граница периода."
          }
        },
        "required": [
          "room_id",
          "idempotency_key",
          "starts_at",
          "ends_at"
        ],
        "additionalProperties": false
      },
      "BookingResponse": {
        "type": "object",
        "description": "",
        "properties": {
          "booking": {
            "$ref": "#/components/schemas/BookingView"
          }
        },
        "required": [
          "booking"
        ],
        "additionalProperties": false
      },
      "BookingView": {
        "type": "object",
        "description": "Снимок владельца Booking. Version участвует в CAS владельца; gateway её не изменяет.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "ACTIVE",
              "CANCELED"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "room_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Системный ID номера, положительное число в строке.",
            "example": "1"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Начало периода, RFC3339 с часовым поясом; точность до микросекунд."
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "description": "Исключительная правая граница периода."
          },
          "room_number": {
            "type": "string",
            "description": "Номер внутри отеля на момент бронирования.",
            "example": "101"
          },
          "room_type": {
            "type": "string",
            "description": "Тип номера на момент бронирования.",
            "example": "Standard"
          }
        },
        "required": [
          "id",
          "version",
          "created_at",
          "updated_at",
          "guest_id",
          "status",
          "request_id",
          "room_id",
          "starts_at",
          "ends_at",
          "room_number",
          "room_type"
        ],
        "additionalProperties": false
      },
      "RpcStatus": {
        "type": "object",
        "description": "Стандартное JSON-представление gRPC Status; сообщение владельца на русском. Машинная причина и идентификатор брони передаются в trailers.",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Числовой gRPC-код, например 3 (InvalidArgument) или 9 (FailedPrecondition)."
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "Arrival": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "room_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Системный ID номера, положительное число в строке.",
            "example": "1"
          },
          "guest_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "ACTIVE",
              "CANCELED"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Начало периода, RFC3339 с часовым поясом; точность до микросекунд."
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "description": "Исключительная правая граница периода."
          },
          "room_number": {
            "type": "string",
            "description": "Номер внутри отеля на момент бронирования.",
            "example": "101"
          },
          "room_type": {
            "type": "string",
            "description": "Тип номера на момент бронирования.",
            "example": "Standard"
          }
        },
        "required": [
          "id",
          "room_id",
          "guest_id",
          "version",
          "status",
          "starts_at",
          "ends_at",
          "room_number",
          "room_type"
        ]
      },
      "CheckinOperation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "booking_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "ACTIVATE",
              "CANCEL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "REJECTED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
