{
  "openapi": "3.1.0",
  "info": {
    "title": "HotelFlow — бронирование и заселение",
    "version": "5.0.0-checkin",
    "description": "Clay gateway проксирует Booking. Booking атомарно сохраняет бронь, период, ключ идемпотентности и outbox. Room владеет каталогом и условиями номеров."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Logical forwarded gateway address; map to existing stand port when implementing."
    }
  ],
  "paths": {
    "/v1/bookings": {
      "post": {
        "operationId": "createBooking",
        "summary": "Создать бронь конкретного номера на период.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Demo-Role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "GUEST"
              ]
            },
            "description": "Учебная роль; владелец повторно проверяет права."
          },
          {
            "name": "X-Demo-Actor",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Обязателен для GUEST. Владение бронью проверяет Booking."
          }
        ],
        "responses": {
          "200": {
            "description": "Сохранённая подтверждённая бронь.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на операцию или чужую бронь.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "409": {
            "description": "FailedPrecondition или Aborted: конфликт либо запрещённое состояние.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "422": {
            "description": "Некорректное тело запроса, UUID, период или длительность для выбранного номера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "503": {
            "description": "Сервис временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "504": {
            "description": "Истекло время ожидания ответа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingInput"
              }
            }
          }
        },
        "description": "Gateway выполняет один RPC Booking.CreateBooking без повторов. Идемпотентность публичного POST отсутствует: повтор может создать другую бронь. Для чтения owner trailers HTTP-клиент передаёт TE: trailers; Grpc-Trailer-X-Error-Code содержит машинную причину, Grpc-Trailer-X-Booking-Id — известный ID брони."
      }
    },
    "/v1/bookings/{booking_id}": {
      "get": {
        "operationId": "getBooking",
        "summary": "Прочитать бронь; GUEST видит только свою.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Demo-Role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "GUEST",
                "RECEPTION",
                "OPERATOR"
              ]
            },
            "description": "Учебная роль; владелец повторно проверяет права."
          },
          {
            "name": "X-Demo-Actor",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Обязателен для GUEST. Владение бронью проверяет Booking."
          },
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Сохранённая подтверждённая бронь.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на операцию или чужую бронь.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "409": {
            "description": "FailedPrecondition или Aborted: конфликт либо запрещённое состояние.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "422": {
            "description": "Некорректное тело запроса, UUID, период или длительность для выбранного номера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "503": {
            "description": "Сервис временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "504": {
            "description": "Истекло время ожидания ответа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rooms/availability": {
      "post": {
        "operationId": "checkAvailability",
        "summary": "Свободные номера отеля на период. Результат не резервирует номер.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Demo-Role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "GUEST",
                "RECEPTION",
                "OPERATOR"
              ]
            },
            "description": "Учебная роль; владелец повторно проверяет права."
          },
          {
            "name": "X-Demo-Actor",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Обязателен для GUEST."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hotel_id",
                  "starts_at",
                  "ends_at"
                ],
                "properties": {
                  "hotel_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Начало периода, RFC3339 с часовым поясом; точность до микросекунд."
                  },
                  "ends_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Исключительная правая граница периода."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Снимок доступности; при создании бронь проверяется повторно.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "room_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$",
                        "example": "1"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/check-in/bookings": {
      "get": {
        "summary": "Ожидающие заселения брони по дате начала",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Demo-Role",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "RECEPTION",
                "OPERATOR"
              ]
            },
            "description": "Учебная роль; владелец повторно проверяет права."
          },
          {
            "name": "X-Demo-Actor",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID оператора"
          },
          {
            "name": "starts_at",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "ends_at",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текущий результат",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bookings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Arrival"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на операцию или чужую бронь.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "409": {
            "description": "FailedPrecondition или Aborted: конфликт либо запрещённое состояние.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "422": {
            "description": "Некорректное тело запроса, UUID, период или длительность для выбранного номера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          },
          "503": {
            "description": "Сервис временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcStatus"
                }
              }
            }
          }
        },
        "description": "CONFIRMED и starts_at в [starts_at,ends_at). Обе query-границы вместе; без них текущие сутки Europe/Moscow."
      }
    },
