# Native fault filters; the private timer listener makes response delay asynchronous.
admin:
  address:
    socket_address: {address: 127.0.0.1, port_value: 9901}
layered_runtime:
  layers:
    - name: capabilities
      static_layer:
        demo.pushback_supported: "1"
        demo.handler_delay_supported: "1"
        demo.handler_abort_supported: "1"
        demo.delay_profile_supported: "1"
    - name: admin
      admin_layer: {}
static_resources:
  listeners:
{{range .Edges}}
    - name: {{.From}}-{{.To}}
      address:
        socket_address: {address: 0.0.0.0, port_value: {{.Port}}}
      per_connection_buffer_limit_bytes: 4194304
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: {{.From}}_{{.To}}
                codec_type: AUTO
                stream_idle_timeout: 120s
                local_reply_config:
                  mappers:
                    - filter:
                        response_flag_filter: {flags: [FI]}
                      headers_to_add:
                        - header: {key: x-hotelflow-injected-abort, value: "1"}
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                route_config:
                  name: {{.From}}-{{.To}}
                  virtual_hosts:
                    - name: destination
                      domains: ["*"]
                      routes:
                        - match: {prefix: "/grpc.reflection."}
                          route: {cluster: {{.To}}, timeout: 0s}
                          typed_per_filter_config:
                            envoy.filters.http.fault:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.fault.v3.HTTPFault
                            envoy.filters.http.lua:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.LuaPerRoute
                              disabled: true
                        - match: {prefix: "/"}
                          route:
                            cluster: {{.To}}
                            timeout: 0s
                            # Honor the caller's remaining gRPC budget in the proxy too.
                            max_stream_duration:
                              grpc_timeout_header_max: 0s
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        json_format:
                          from: "{{.From}}"
                          to: "{{.To}}"
                          method: "%REQ(:PATH)%"
                          request_id: "%REQ(X-REQUEST-ID)%"
                          hedge_attempt: "%REQ(X-HEDGE-ATTEMPT)%"
                          injected_delay_ms: "%REQ(X-ENVOY-FAULT-DELAY-REQUEST)%"
                          upstream_host: "%UPSTREAM_HOST%"
                          traceparent: "%REQ(TRACEPARENT)%"
                          duration_ms: "%DURATION%"
                          grpc_status: "%GRPC_STATUS%"
                          response_flags: "%RESPONSE_FLAGS%"
                http_filters:
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      default_source_code:
                        inline_string: |
{{if eq .To "booking"}}
                          function envoy_on_request(handle)
                            -- Never accept a client-supplied injection header.
                            handle:headers():remove("x-envoy-fault-delay-request")
                            handle:headers():remove("x-envoy-fault-delay-request-percentage")
                            local response, body = handle:httpCall("fault-runtime", {
                              [":method"] = "GET", [":path"] = "/runtime", [":authority"] = "localhost"
                            }, "", 1000)
                            if response == nil or response[":status"] ~= "200" or body == nil then
                              return
                            end
                            local key = string.gsub("demo.{{.From}}.{{.To}}.request.delay_profile", "(%W)", "%%%1")
                            local profile = string.match(body, '"' .. key .. '"%s*:%s*{.-"final_value"%s*:%s*"([^"}]+)"')
                            if profile == nil or profile == "disabled" then
                              return
                            end
                            -- One draw selects at most one group: delays never add up.
                            local draw = math.random(100)
                            local cumulative = 0
                            for percent, delay in string.gmatch(profile, "(%d+):(%d+)") do
                              cumulative = cumulative + tonumber(percent)
                              if draw <= cumulative then
                                handle:headers():replace("x-envoy-fault-delay-request", delay)
                                return
                              end
                            end
                          end
{{end}}
{{if eq .To "review"}}
                          function envoy_on_request(handle)
                            -- Only hotelctl runtime may supply this demo parameter.
                            handle:headers():remove("x-hotelflow-handler-delay-ms")
                            handle:headers():remove("x-hotelflow-handler-unavailable")
                            if handle:headers():get(":path") ~= "/review.review.v1.ReviewService/GetHotelRatings" then
                              return
                            end
                            local response, body = handle:httpCall("fault-runtime", {
                              [":method"] = "GET", [":path"] = "/runtime", [":authority"] = "localhost"
                            }, "", 1000)
                            if response == nil or response[":status"] ~= "200" or body == nil then
                              return
                            end
                            local prefix = "demo.{{.From}}.{{.To}}.handler."
                            local function value(name)
                              local key = string.gsub(prefix .. name, "(%W)", "%%%1")
                              return tonumber(string.match(body, '"' .. key .. '"%s*:%s*{.-"final_value"%s*:%s*"([^"}]+)"'))
                            end
                            local abort = value("abort_percent") or 0
                            if math.random(100) <= abort then
                              handle:headers():replace("x-hotelflow-handler-unavailable", "1")
                              return
                            end
                            local percent = value("delay_percent") or 0
                            local delay = value("delay_ms") or 0
                            if delay >= 1 and delay <= 60000 and math.random(100) <= percent then
                              handle:headers():replace("x-hotelflow-handler-delay-ms", tostring(delay))
                            end
                          end
{{end}}
                          function envoy_on_response(handle)
                            local injected = handle:headers():get("x-hotelflow-injected-abort")
                            handle:headers():remove("x-hotelflow-injected-abort")
                            if injected == "1" and handle:headers():get("grpc-status") == "14" then
                              -- Only injected failures query the loopback admin endpoint.
                              -- /runtime's final_value is a string; CLI writes only int32 or "disabled".
                              local response, body = handle:httpCall("fault-runtime", {
                                [":method"] = "GET", [":path"] = "/runtime", [":authority"] = "localhost"
                              }, "", 1000)
                              if response ~= nil and response[":status"] == "200" and body ~= nil then
                                local key = string.gsub("demo.{{.From}}.{{.To}}.request.pushback_ms", "(%W)", "%%%1")
                                local value = string.match(body, '"' .. key .. '"%s*:%s*{.-"final_value"%s*:%s*"([^"}]+)"')
                                if value ~= nil and string.match(value, "^%-?%d+$") then
                                  -- Fault's local gRPC reply is trailers-only (END_STREAM).
                                  handle:headers():replace("grpc-retry-pushback-ms", value)
                                end
                              else
                                handle:logErr("Could not read fault pushback runtime")
                              end
                              return
                            end
                            -- Unary result is complete upstream, but still buffered here.
                            handle:body()
                            local headers = handle:httpCall("delay-{{.From}}-{{.To}}", {
                              [":method"] = "GET", [":path"] = "/", [":authority"] = "delay"
                            }, "", 61000)
                            if headers == nil or headers[":status"] ~= "204" then
                              handle:logErr("Envoy response delay listener failed")
                            end
                          end
{{if eq .To "booking"}}
                  - name: envoy.filters.http.fault
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.fault.v3.HTTPFault
                      delay:
                        header_delay: {}
                        percentage: {numerator: 0, denominator: HUNDRED}
                      delay_percent_runtime: demo.{{.From}}.{{.To}}.request.profile_percent
{{end}}
                  - name: envoy.filters.http.fault
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.fault.v3.HTTPFault
                      delay:
                        fixed_delay: 0.001s
                        percentage: {numerator: 0, denominator: HUNDRED}
                      abort:
                        grpc_status: 14
                        percentage: {numerator: 0, denominator: HUNDRED}
                      delay_percent_runtime: demo.{{.From}}.{{.To}}.request.delay_percent
                      delay_duration_runtime: demo.{{.From}}.{{.To}}.request.delay_ms
                      abort_percent_runtime: demo.{{.From}}.{{.To}}.request.abort_percent
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
    - name: delay-{{.From}}-{{.To}}
      address:
        socket_address: {address: 127.0.0.1, port_value: {{.DelayPort}}}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: response_delay_{{.From}}_{{.To}}
                route_config:
                  name: delay
                  virtual_hosts:
                    - name: delay
                      domains: ["*"]
                      routes:
                        - match: {prefix: "/"}
                          direct_response: {status: 204}
                http_filters:
                  - name: envoy.filters.http.fault
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.fault.v3.HTTPFault
                      delay:
                        fixed_delay: 0.001s
                        percentage: {numerator: 0, denominator: HUNDRED}
                      delay_percent_runtime: demo.{{.From}}.{{.To}}.response.delay_percent
                      delay_duration_runtime: demo.{{.From}}.{{.To}}.response.delay_ms
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
{{end}}
  clusters:
    - name: fault-runtime
      type: STATIC
      connect_timeout: 1s
      load_assignment:
        cluster_name: fault-runtime
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: {address: 127.0.0.1, port_value: 9901}
{{range .Edges}}
    - name: delay-{{.From}}-{{.To}}
      type: STATIC
      connect_timeout: 1s
      load_assignment:
        cluster_name: delay-{{.From}}-{{.To}}
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: {address: 127.0.0.1, port_value: {{.DelayPort}}}
{{end}}
{{range .Upstreams}}
    - name: {{.Name}}
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      dns_lookup_family: V4_ONLY
      dns_refresh_rate: 1s
      connect_timeout: 2s
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: {{.Name}}
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: {address: {{.Address}}, port_value: 9090}
{{end}}
