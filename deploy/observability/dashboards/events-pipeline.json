        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer lag by group and topic",
      "description": "Сумма отставания по партициям. Без известного offset партиция не входит в расчёт.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (consumergroup, topic) (max by (consumergroup, topic, partition) (kafka_consumergroup_lag{job=\"kafka-exporter\",topic=~\"$kafka_topic\",consumergroup=~\"$consumer_group\"} >= 0))",
          "legendFormat": "{{consumergroup}} · {{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "width": 390
        }
      }
    },
    {
      "id": 8,
      "type": "status-history",
      "title": "Partition leadership",
      "description": "Каждая отметка показывает лидера конкретной партиции в момент измерения. Наведите на отметку, чтобы увидеть ID брокера.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "max by (topic, partition) (kafka_topic_partition_leader{job=\"kafka-exporter\",topic=~\"$kafka_topic\"})",
          "legendFormat": "{{topic}} · p{{partition}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "5s"
        }
      ],
      "maxDataPoints": 150,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 95,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "index": 0,
                  "text": "Broker 1",
                  "color": "#37872D"
                },
                "2": {
                  "index": 1,
                  "text": "Broker 2",
                  "color": "#73BF69"
                },
                "3": {
                  "index": 2,
                  "text": "Broker 3",
                  "color": "#96D98D"
                },
                "-1": {
                  "index": 3,
                  "text": "No leader",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "colWidth": 0.45,
        "rowHeight": 0.58,
        "perPage": 12,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Records appended per second",
      "description": "Темп прироста offset по партициям, суммарно по топику. Интервалы со снижением offset исключаются из расчёта.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (topic) (max by (topic, partition) (clamp_min(deriv(kafka_topic_partition_current_offset{job=\"kafka-exporter\",topic=~\"$kafka_topic\"}[$__rate_interval]), 0) and (resets(kafka_topic_partition_current_offset{job=\"kafka-exporter\",topic=~\"$kafka_topic\"}[$__rate_interval]) == 0)))",
          "legendFormat": "{{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "width": 390
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Inbox",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
