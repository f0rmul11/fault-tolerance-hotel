    {
      "id": 5,
      "type": "stat",
      "title": "Under-replicated",
      "description": "Партиция считается недореплицированной, если ISR меньше набора назначенных реплик.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum(max by (topic, partition) (kafka_topic_partition_under_replicated_partition{job=\"kafka-exporter\",topic=~\"$kafka_topic\"}))",
          "legendFormat": "Under-replicated",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
