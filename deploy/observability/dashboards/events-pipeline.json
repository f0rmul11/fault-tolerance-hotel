    {
      "id": 22,
      "type": "timeseries",
      "title": "Inbox error limit and panics",
      "description": "Error limit считает неудачные пакеты, в которых хотя бы одно сообщение достигло лимита ошибок. Panic считает перехваченные паники обработчика.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (topic) (rate(inbox_can_not_handler_message_by_inbox_total{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}[$__rate_interval])) or on (topic) (0 * max by (topic) (inbox_pending_messages{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}))",
          "legendFormat": "Error limit · {{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "3s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (topic) (rate(inbox_panic_handler_message_by_inbox_total{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}[$__rate_interval])) or on (topic) (0 * max by (topic) (inbox_pending_messages{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}))",
          "legendFormat": "Panic · {{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "3s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Error limit · /"
