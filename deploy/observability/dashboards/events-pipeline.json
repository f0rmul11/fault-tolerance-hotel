      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Message flow",
      "description": "Запись и успешная обработка сообщений в Inbox по топику.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (topic) (rate(inbox_inbox_messages_written_total{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}[$__rate_interval]))",
          "legendFormat": "Written · {{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "3s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (topic) (rate(inbox_inbox_messages_processed_total{service_namespace=\"hotelflow\",service_name=\"$service\",topic=~\"$kafka_topic\"}[$__rate_interval]))",
          "legendFormat": "Processed · {{topic}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "3s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(processed|published|succeeded) · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^stored · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^failed · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Duplicate writes · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
