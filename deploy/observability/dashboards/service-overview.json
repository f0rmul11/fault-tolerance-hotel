{
  "id": null,
  "uid": "hotelflow-service-overview",
  "title": "Service Overview",
  "tags": [
    "hotelflow",
    "services"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "links": [
    {
      "title": "Jaeger",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hotelflow-prometheus"
        },
        "definition": "label_values(target_info{service_namespace=\"hotelflow\"}, service_name)",
        "query": {
          "query": "label_values(target_info{service_namespace=\"hotelflow\"}, service_name)",
          "refId": "ServiceVariable"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "api-gateway",
          "value": "api-gateway"
        },
        "options": [],
        "allowCustomValue": false
      },
      {
        "name": "protocol",
        "label": "Protocol",
        "type": "custom",
        "query": "grpc,http",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "grpc",
            "value": "grpc",
            "selected": false
          },
          {
            "text": "http",
            "value": "http",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response codes ratio",
      "description": "Доли завершённых запросов по категориям. Легенда Mean / Last / Max / Min показывает исходный поток req/s за выбранный диапазон. status в метрике сохраняет точный HTTP/gRPC-код. При отсутствии запросов доли не определены.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 55,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "percent",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "canceled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client_error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "not_found"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "width": 460,
          "calcs": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"ok\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"canceled\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"client_error\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"not_found\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate by handler (only errors)",
      "description": "Технические ошибки в req/s: gRPC Internal, Unavailable, DeadlineExceeded, Unknown, ResourceExhausted, Unimplemented, DataLoss; HTTP 5xx. Отказ до входа в сервис виден на вызывающей стороне.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "width": 460,
          "calcs": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotelflow-prometheus"
          },
          "expr": "sum by (handler) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^/[^/]+/(.+)$",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate by handler (only client errors)",
      "description": "Отказы на входящие запросы: валидация, авторизация, конфликт состояния. HTTP 4xx кроме 404/499; gRPC InvalidArgument, AlreadyExists, PermissionDenied, Unauthenticated, FailedPrecondition, Aborted, OutOfRange. NotFound и Canceled отдельно в верхней панели.",
      "datasource": {
        "type": "prometheus",
        "uid": "hotelflow-prometheus"
      },
      "gridPos": {
        "x": 0,
