          "expr": "sum by (handler) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"client_error\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
