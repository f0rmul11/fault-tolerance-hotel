          "expr": "sum by (code) (rate(hotelflow_server_requests_total{service_namespace=\"hotelflow\",service_name=~\"${service:regex}\",protocol=~\"${protocol:regex}\",code=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "range": true,
