    "schemas": {
      "booking.confirmed.v1": {
        "type": "object",
        "properties": {
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID события; ключ идемпотентности inbox, совпадает с x-correlation-id."
          },
          "event_type": {
            "type": "string",
            "enum": [
              "booking.confirmed.v1"
            ]
          },
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID брони, к которой относится событие; совпадает с ключом Kafka."
          },
          "booking_version": {
            "type": "integer",
            "minimum": 1,
            "description": "Версия брони в Booking."
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID исходного запроса для трассировки."
          },
          "payload": {
            "type": "object",
            "properties": {
              "room_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "description": "Системный ID номера, положительное число в строке.",
                "example": "1"
              },
              "guest_id": {
                "type": "string",
                "format": "uuid"
              },
              "starts_at": {
                "type": "string",
                "format": "date-time"
              },
              "ends_at": {
                "type": "string",
                "format": "date-time"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONFIRMED"
                ]
              },
              "room_number": {
                "type": "string",
                "description": "Номер внутри отеля на момент бронирования.",
                "example": "101"
              },
              "room_type": {
                "type": "string",
                "description": "Тип номера на момент бронирования.",
                "example": "Standard"
              }
            },
            "required": [
              "room_id",
              "guest_id",
              "starts_at",
              "ends_at",
              "created_at",
              "status",
              "room_number",
              "room_type"
            ]
          }
        },
        "required": [
          "correlation_id",
          "event_type",
          "booking_id",
          "booking_version",
          "occurred_at",
          "request_id",
          "payload"
        ]
      },
