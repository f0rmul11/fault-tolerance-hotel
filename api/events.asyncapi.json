{
  "asyncapi": "2.6.0",
  "info": {
    "title": "HotelFlow Booking / Check-in request-reply",
    "version": "1.0.0",
    "description": "Собственные сущности Booking и CheckIn. Явные события и идемпотентность по correlation-id."
  },
  "defaultContentType": "application/json",
  "servers": {
    "kafka": {
      "url": "kafka:9092",
      "protocol": "kafka"
    }
  },
  "channels": {
    "booking.events.v1": {
      "publish": {
        "operationId": "booking_publish",
        "x-producer": "booking",
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/booking.confirmed.v1"
            },
            {
              "$ref": "#/components/messages/booking.activated.v1"
            },
            {
              "$ref": "#/components/messages/booking.canceled.v1"
            },
            {
              "$ref": "#/components/messages/booking.checkin-rejected.v1"
            }
          ]
        }
      },
      "subscribe": {
        "operationId": "check_in_consume",
        "x-consumer": "check-in",
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/booking.confirmed.v1"
            },
            {
              "$ref": "#/components/messages/booking.activated.v1"
            },
            {
              "$ref": "#/components/messages/booking.canceled.v1"
            },
            {
              "$ref": "#/components/messages/booking.checkin-rejected.v1"
            }
          ]
        }
      },
      "bindings": {
        "kafka": {
          "topic": "booking.events.v1",
          "bindingVersion": "0.4.0"
        }
      }
    },
    "checkin.events.v1": {
      "publish": {
        "operationId": "check_in_publish",
        "x-producer": "check-in",
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/checkin.arrival-requested.v1"
            },
            {
              "$ref": "#/components/messages/checkin.cancellation-requested.v1"
            }
          ]
        }
      },
      "subscribe": {
        "operationId": "booking_consume",
        "x-consumer": "booking",
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/checkin.arrival-requested.v1"
            },
            {
              "$ref": "#/components/messages/checkin.cancellation-requested.v1"
            }
          ]
        }
      },
      "bindings": {
        "kafka": {
          "topic": "checkin.events.v1",
          "bindingVersion": "0.4.0"
        }
      }
    }
